<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CIC Loan & Monthly Text Report System</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
    body { font-family: 'Inter', sans-serif; }
    .tab-active { border-bottom: 3px solid #2563eb; color: #2563eb; font-weight: 600; }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 font-sans min-h-screen">

  <!-- Header -->
  <header class="bg-blue-900 text-white shadow-lg">
    <div class="max-w-7xl mx-auto px-6 py-4 flex flex-col md:flex-row justify-between items-center">
      <div class="flex items-center space-x-3 mb-4 md:mb-0">
        <i class="fa-solid fa-building-columns text-yellow-400 text-2xl"></i>
        <div>
          <h1 class="text-xl font-bold leading-tight">CIC Loan Management & Reporting System</h1>
          <p class="text-xs text-blue-200">Automated Monthly Pipe-Delimited (.TXT) Generator</p>
        </div>
      </div>
      <div class="flex items-center space-x-4 text-sm bg-blue-800 px-4 py-2 rounded-lg">
        <div><span class="text-blue-300">Provider:</span> <strong>CO018670</strong></div>
        <div class="border-l border-blue-700 h-4"></div>
        <div><span class="text-blue-300">Branch:</span> <strong>22038</strong></div>
      </div>
    </div>
  </header>

  <!-- Navigation Tabs -->
  <div class="bg-white border-b shadow-sm">
    <div class="max-w-7xl mx-auto px-6 flex space-x-8 overflow-x-auto">
      <button onclick="switchTab('dashboard')" id="tab-btn-dashboard" class="py-4 px-2 tab-active flex items-center space-x-2 whitespace-nowrap">
        <i class="fa-solid fa-chart-line"></i><span>Dashboard</span>
      </button>
      <button onclick="switchTab('products')" id="tab-btn-products" class="py-4 px-2 text-slate-500 hover:text-blue-600 flex items-center space-x-2 whitespace-nowrap">
        <i class="fa-solid fa-boxes-packing"></i><span>Loan Products</span>
      </button>
      <button onclick="switchTab('members')" id="tab-btn-members" class="py-4 px-2 text-slate-500 hover:text-blue-600 flex items-center space-x-2 whitespace-nowrap">
        <i class="fa-solid fa-users"></i><span>Members (IDs)</span>
      </button>
      <button onclick="switchTab('loans')" id="tab-btn-loans" class="py-4 px-2 text-slate-500 hover:text-blue-600 flex items-center space-x-2 whitespace-nowrap">
        <i class="fa-solid fa-hand-holding-dollar"></i><span>Loans (CIs)</span>
      </button>
      <button onclick="switchTab('reports')" id="tab-btn-reports" class="py-4 px-2 text-slate-500 hover:text-blue-600 flex items-center space-x-2 whitespace-nowrap">
        <i class="fa-solid fa-file-export"></i><span>Generate CIC Report</span>
      </button>
    </div>
  </div>

  <!-- Main Content -->
  <main class="max-w-7xl mx-auto px-6 py-8">

    <!-- 1. DASHBOARD TAB -->
    <section id="tab-dashboard" class="space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
          <div class="text-slate-500 text-sm font-medium">No. of Customers (IDs)</div>
          <div class="text-3xl font-bold text-slate-800 mt-2" id="stat-members">0</div>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
          <div class="text-slate-500 text-sm font-medium">Credit Records (CIs)</div>
          <div class="text-3xl font-bold text-emerald-600 mt-2" id="stat-loans">0</div>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
          <div class="text-slate-500 text-sm font-medium">Total Records (ID + CI + HD/FT)</div>
          <div class="text-3xl font-bold text-indigo-600 mt-2" id="stat-total">0</div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
          <div class="text-slate-500 text-sm font-medium">Installment Contracts</div>
          <div class="text-3xl font-bold text-blue-600 mt-2" id="stat-installment">0</div>
          <p class="text-xs text-slate-400 mt-1">Mga pautang nga labaw sa usa ka bulan ang term</p>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
          <div class="text-slate-500 text-sm font-medium">Non-Installment Contracts</div>
          <div class="text-3xl font-bold text-amber-600 mt-2" id="stat-noninstallment">0</div>
          <p class="text-xs text-slate-400 mt-1">Mga pautang nga single payment / lump-sum</p>
        </div>
      </div>
    </section>

    <!-- 2. LOAN PRODUCTS TAB -->
    <section id="tab-products" class="hidden space-y-6">
      <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200 mb-6">
        <h2 class="text-lg font-bold text-slate-800 mb-4"><i class="fa-solid fa-plus-circle text-blue-600 me-2"></i> Add New Loan Product</h2>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Product Name</label>
            <input type="text" id="p-name" placeholder="e.g. Providential Loan" class="w-full px-3 py-2 border rounded-lg text-sm">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Interest (%)</label>
            <input type="number" id="p-interest" value="2.5" class="w-full px-3 py-2 border rounded-lg text-sm">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Penalty (%)</label>
            <input type="number" id="p-penalty" value="2.0" class="w-full px-3 py-2 border rounded-lg text-sm">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Term (Months)</label>
            <input type="number" id="p-term" value="12" class="w-full px-3 py-2 border rounded-lg text-sm">
          </div>
        </div>
        <button onclick="addLoanProduct()" class="mt-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-2 rounded-lg text-sm transition">
          <i class="fa-solid fa-save me-1"></i> Save Product
        </button>
      </div>

      <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
        <h2 class="text-lg font-bold text-slate-800 mb-4">Loan Products List</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm text-slate-600">
            <thead class="bg-slate-50 text-slate-700 font-semibold uppercase text-xs border-b">
              <tr>
                <th class="py-3 px-3">Name</th>
                <th class="py-3 px-3">Interest</th>
                <th class="py-3 px-3">Penalty</th>
                <th class="py-3 px-3">Term</th>
                <th class="py-3 px-3">Actions (Password Protected)</th>
              </tr>
            </thead>
            <tbody id="product-table-body" class="divide-y"></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 3. MEMBERS TAB -->
    <section id="tab-members" class="hidden space-y-6">
      <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200 mb-6">
        <h2 class="text-lg font-bold text-slate-800 mb-4"><i class="fa-solid fa-user-plus text-blue-600 me-2"></i> Add New Member (CIC ID Line)</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Subject ID (e.g. 22038000999)</label>
            <input type="text" id="m-id" value="22038000999" class="w-full px-3 py-2 border rounded-lg text-sm font-mono">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">First Name</label>
            <input type="text" id="m-fname" placeholder="JUAN" class="w-full px-3 py-2 border rounded-lg text-sm">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Last Name</label>
            <input type="text" id="m-lname" placeholder="DELA CRUZ" class="w-full px-3 py-2 border rounded-lg text-sm">
          </div>
        </div>
        <button onclick="addMember()" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-2 rounded-lg text-sm transition">
          <i class="fa-solid fa-user-check me-1"></i> Generate & Add Member ID
        </button>
      </div>

      <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
        <h2 class="text-lg font-bold text-slate-800 mb-4 flex items-center justify-between">
          <span><i class="fa-solid fa-users text-blue-600 me-2"></i> Loaded Borrower ID Records</span>
          <span class="text-xs text-slate-500 font-normal">Total: <strong id="member-count-badge">0</strong> records</span>
        </h2>
        <div class="overflow-x-auto max-h-[500px]">
          <table class="w-full text-left text-sm text-slate-600">
            <thead class="bg-slate-50 text-slate-700 font-semibold uppercase text-xs border-b sticky top-0">
              <tr>
                <th class="py-3 px-3">Subject ID</th>
                <th class="py-3 px-3">Name / Details</th>
                <th class="py-3 px-3">Raw CIC ID Line</th>
                <th class="py-3 px-3">Actions</th>
              </tr>
            </thead>
            <tbody id="member-table-body" class="divide-y font-mono text-xs"></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 4. LOANS TAB -->
    <section id="tab-loans" class="hidden space-y-6">
      <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200 mb-6">
        <h2 class="text-lg font-bold text-slate-800 mb-4"><i class="fa-solid fa-file-circle-plus text-emerald-600 me-2"></i> Add New Loan / Credit Contract (CI Line)</h2>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-4">
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Member ID</label>
            <input type="text" id="l-memberid" value="22038000001" class="w-full px-3 py-2 border rounded-lg text-sm font-mono">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Account Number / PN No.</label>
            <input type="text" id="l-acctno" value="22038-42-00999-1" class="w-full px-3 py-2 border rounded-lg text-sm font-mono">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Loan Amount (PHP)</label>
            <input type="number" id="l-amount" value="50000" class="w-full px-3 py-2 border rounded-lg text-sm">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Term (Months)</label>
            <input type="number" id="l-term" value="12" class="w-full px-3 py-2 border rounded-lg text-sm">
          </div>
        </div>
        <button onclick="addLoan()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-4 py-2 rounded-lg text-sm transition">
          <i class="fa-solid fa-hand-holding-dollar me-1"></i> Add Loan Contract (CI)
        </button>
      </div>

      <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
        <h2 class="text-lg font-bold text-slate-800 mb-4 flex items-center justify-between">
          <span><i class="fa-solid fa-hand-holding-dollar text-emerald-600 me-2"></i> Loaded Credit Account (CI) Records</span>
          <span class="text-xs text-slate-500 font-normal">Total: <strong id="loan-count-badge">0</strong> records</span>
        </h2>
        <div class="overflow-x-auto max-h-[500px]">
          <table class="w-full text-left text-sm text-slate-600">
            <thead class="bg-slate-50 text-slate-700 font-semibold uppercase text-xs border-b sticky top-0">
              <tr>
                <th class="py-3 px-3">Account No.</th>
                <th class="py-3 px-3">Member ID</th>
                <th class="py-3 px-3">Contract Type</th>
                <th class="py-3 px-3">Raw CIC CI Line</th>
                <th class="py-3 px-3">Actions</th>
              </tr>
            </thead>
            <tbody id="loan-table-body" class="divide-y font-mono text-xs"></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 5. GENERATE REPORT TAB -->
    <section id="tab-reports" class="hidden space-y-6">
      <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200 max-w-5xl mx-auto">
        <h2 class="text-xl font-bold text-slate-800 mb-2 flex items-center">
          <i class="fa-solid fa-file-export text-blue-600 me-2"></i> Monthly CIC Report Generator
        </h2>
        <p class="text-sm text-slate-500 mb-6">Generates exact format matching your official CIC CSDF file structure with ID and CI records.</p>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6 bg-slate-50 p-4 rounded-xl border">
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">PROVIDER CODE</label>
            <input type="text" id="r-provider" value="CO018670" class="w-full px-3 py-2 border rounded-lg text-sm font-semibold text-slate-700">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">BRANCH CODE</label>
            <input type="text" id="r-branch" value="22038" class="w-full px-3 py-2 border rounded-lg text-sm font-semibold text-slate-700">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">AS OF DATE (DDMMYYYY)</label>
            <input type="text" id="r-asofdate" value="30092026" class="w-full px-3 py-2 border rounded-lg text-sm font-semibold text-blue-600 outline-none">
          </div>
        </div>

        <div class="flex justify-between items-center mb-4">
          <button onclick="previewReport()" class="bg-slate-800 hover:bg-slate-900 text-white font-semibold px-4 py-2 rounded-lg text-sm transition flex items-center space-x-2">
            <i class="fa-solid fa-eye"></i><span>Refresh Preview</span>
          </button>
          <button onclick="downloadReportFile()" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-lg text-sm shadow transition flex items-center space-x-2">
            <i class="fa-solid fa-download"></i><span>Download .TXT File</span>
          </button>
        </div>

        <div class="bg-slate-900 text-green-400 p-4 rounded-xl font-mono text-xs overflow-x-auto h-96 border border-slate-800">
          <pre id="report-preview-box" style="white-space: pre-wrap; word-break: break-all;">Loading preview...</pre>
        </div>
      </div>
    </section>

  </main>

  <script>
    const ADMIN_PASSWORD = "admin123"; // Pwede nimo ilisan ang password diri kung gusto nimo

    let db = {
      products: [
        { id: "P1", name: "Agricultural Loan", interest: 3.0, penalty: 2.0, term: 12 }
      ],
      idLines: [
        `ID|CO018670|22038|30092026|22038000001|13|DARLYN|ABARRE|LLANDINO||||F|08011987||PH|PH||2|||||||||||||MI| San Vicente PROSPERIDAD (Capital) AGUSAN DEL SUR PH 8500||||||||||AI| San Vicente PROSPERIDAD (Capital) AGUSAN DEL SUR PH 8500||||||||||10|705051946|||||||||||||||||||||||3|09262484148||||||||||||||||||||||||||||||||||||||||||||`,
        `ID|CO018670|22038|30092026|22038000004|10|CRISOGONO|ABAWAN|T.||||M|22111961||PH|PH||1|||||||||||||MI|2 San Vicente PROSPERIDAD (Capital) AGUSAN DEL SUR PH 8500||||||||||AI|2 PROSPERIDAD (Capital) AGUSAN DEL SUR PH 8500|||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||`,
        `ID|CO018670|22038|30092026|22038000011|10|RANDY|ABELLAR|GRINGIN||||M|06041984|PROSPERIDAD, ADS|PH|PH||2|||||||DIONICA FLORES GRINGIN||RODOLFO|ABELLAR|BACLAAN|SR.|MI|P-2 Lucena PROSPERIDAD (Capital) AGUSAN DEL SUR PH 8500||||||||||AI|P-2 PROSPERIDAD (Capital) AGUSAN DEL SUR PH 8500||||||||||10|414438851000|||||||||||||||||||||||3|09488531483||||||||||||||||||||||||||||||||||||||||||||`,
        `ID|CO018670|22038|30092026|22038000015|10|DEMOCRITO|ABLID|RIVERA||||M|18121978|ZILLOVIA, AGUSAN SUR|PH|PH||1|||||||PERLA CATABAY RIVERA||JUAN|ABLID|GARCIA||MI|P-1 Zillovia TALACOGON AGUSAN DEL SUR PH 8510||||||||||AI|P-1 TALACOGON AGUSAN DEL SUR PH 8510||||||||||10|309400920000|11|0932917300|||||||||||||||||||||3|09474223944||||||||||||||||||||||||||||||||||||||||||||`,
        `ID|CO018670|22038|30092026|22038000032|13|MARDJELIN|AGUIRRE|VICADA|||AGUIRRE|F|31051987|AGUSAN DEL SUR|PH|PH||2|||||||SOCRATISA FLORES MONTEJO||ENRIQUE|VICADA|TABADA||MI|P-2 STA. CRUZ Del Monte TALACOGON AGUSAN DEL SUR PH 8510||||||||||AI|P-2 STA. CRUZ STA. CRUZ TALACOGON AGUSAN DEL SUR PH 8510||||||||||10|724197948000|||||||||||||||||||||||3|09128434717||||||||||||||||||||||||||||||||||||||||||||`
      ],
      ciLines: [
        `CI|CO018670|22038|30092026|22038000001|B|22038-42-00675-1|21|AC||PHP|PHP|17082023||29042025|||||60000|1|NA||I||3000||0|||1|60000|1|60000|6||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||`,
        `CI|CO018670|22038|30092026|22038000004|B|22038-44-00321-8|10|AC||PHP|PHP|31012022||01072025|||||135000|1|NA||I||3214||0|||1||1|1|6||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||`,
        `CI|CO018670|22038|30092026|22038000011|B|22038-43-00658-3|10|AC||PHP|PHP|11072026||11012027|||||180000|1|NA||I||30000||0|||1|180000|0|0|0||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||`,
        `CI|CO018670|22038|30092026|22038000015|B|22038-44-00227-2|10|AC||PHP|PHP|23122020||15072025|||||160333|1|NA||I||2915||0|||1|131500|1|131500|6||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||`,
        `CI|CO018670|22038|30092026|22038000032|B|22038-42-00832-9|21|AC||PHP|PHP|03122024||03122025|||||40000|12|NA||M||3333||0|||10|32654|10|32654|6||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||`
      ]
    };

    function init() {
      renderDashboard();
      renderProducts();
      renderMembers();
      renderLoans();
      previewReport();
    }

    function switchTab(t) {
      ['dashboard', 'products', 'members', 'loans', 'reports'].forEach(tab => {
        document.getElementById(`tab-${tab}`).classList.add('hidden');
        document.getElementById(`tab-btn-${tab}`).classList.remove('tab-active');
        document.getElementById(`tab-btn-${tab}`).classList.add('text-slate-500');
      });
      document.getElementById(`tab-${t}`).classList.remove('hidden');
      document.getElementById(`tab-btn-${t}`).classList.add('tab-active');
      document.getElementById(`tab-btn-${t}`).classList.remove('text-slate-500');
    }

    function verifyPassword() {
      const pwd = prompt("Enter Admin Password to continue:");
      if (pwd === null) return false; // Gi-cancel
      if (pwd !== ADMIN_PASSWORD) {
        alert("Sayop ang password! Dili mahimo kining operasyon.");
        return false;
      }
      return true;
    }

    function renderDashboard() {
      let installmentCount = 0;
      let nonInstallmentCount = 0;

      db.ciLines.forEach(line => {
        const parts = line.split('|');
        const term = parseInt(parts[19]) || 1;
        const freq = parts[23] || '';
        if (term > 1 || freq === 'M' || freq === 'Q' || freq === 'W') {
          installmentCount++;
        } else {
          nonInstallmentCount++;
        }
      });

      document.getElementById('stat-members').innerText = db.idLines.length;
      document.getElementById('stat-loans').innerText = db.ciLines.length;
      document.getElementById('stat-installment').innerText = installmentCount;
      document.getElementById('stat-noninstallment').innerText = nonInstallmentCount;
      document.getElementById('stat-total').innerText = db.idLines.length + db.ciLines.length + 2;
    }

    function addLoanProduct() {
      const name = document.getElementById('p-name').value;
      const interest = document.getElementById('p-interest').value;
      const penalty = document.getElementById('p-penalty').value;
      const term = document.getElementById('p-term').value;

      if(!name) {
        alert('Palihug isulat ang ngalan sa loan product.');
        return;
      }

      db.products.push({ id: "P" + (db.products.length + 1), name, interest, penalty, term });
      renderProducts();
      alert('Na-save na ang bag-ong Loan Product!');
      document.getElementById('p-name').value = '';
    }

    function editProduct(index) {
      if (!verifyPassword()) return;
      const p = db.products[index];
      const newName = prompt("Bag-ong Ngalan sa Product:", p.name);
      if (newName === null) return;
      const newInt = prompt("Bag-ong Interest (%):", p.interest);
      if (newInt === null) return;

      p.name = newName;
      p.interest = newInt;
      renderProducts();
      alert("Na-update na ang Loan Product!");
    }

    function deleteProduct(index) {
      if (!verifyPassword()) return;
      if (confirm("Sigurado ka ba nga i-delete kining loan product?")) {
        db.products.splice(index, 1);
        renderProducts();
        alert("Na-delete na ang produkto.");
      }
    }

    function addMember() {
      const mId = document.getElementById('m-id').value;
      const fname = document.getElementById('m-fname').value.toUpperCase();
      const lname = document.getElementById('m-lname').value.toUpperCase();

      if(!mId || !fname || !lname) {
        alert('Palihug i-fill up ang tanang natad (Subject ID, First Name, Last Name).');
        return;
      }

      const newLine = `ID|CO018670|22038|30092026|${mId}|13|${fname}||${lname}||||F|01011990||PH|PH||2|||||||||||||MI|PROSPERIDAD AGUSAN DEL SUR PH 8500||||||||||AI|PROSPERIDAD AGUSAN DEL SUR PH 8500||||||||||10|123456789|||||||||||||||||||||||3|09123456789||||||||||||||||||||||||||||||||||||||||||||`;
      db.idLines.push(newLine);
      renderMembers();
      renderDashboard();
      previewReport();
      alert('Na-add na ang bag-ong Member ID!');
      document.getElementById('m-fname').value = '';
      document.getElementById('m-lname').value = '';
    }

    function editMember(index) {
      if (!verifyPassword()) return;
      const currentLine = db.idLines[index];
      const parts = currentLine.split('|');
      const newFname = prompt("Usba ang First Name:", parts[6]);
      if (newFname === null) return;
      const newLname = prompt("Usba ang Last Name:", parts[8]);
      if (newLname === null) return;

      parts[6] = newFname.toUpperCase();
      parts[8] = newLname.toUpperCase();
      db.idLines[index] = parts.join('|');
      
      renderMembers();
      renderDashboard();
      previewReport();
      alert("Na-update na ang Member ID record!");
    }

    function deleteMember(index) {
      if (!verifyPassword()) return;
      if (confirm("Sigurado ka ba nga i-delete kining Member ID?")) {
        db.idLines.splice(index, 1);
        renderMembers();
        renderDashboard();
        previewReport();
        alert("Na-delete na ang Member ID.");
      }
    }

    function addLoan() {
      const memberId = document.getElementById('l-memberid').value;
      const acctNo = document.getElementById('l-acctno').value;
      const amount = document.getElementById('l-amount').value;
      const term = parseInt(document.getElementById('l-term').value) || 1;

      if(!memberId || !acctNo || !amount) {
        alert('Palihug i-fill up ang tanang detalye sa loan.');
        return;
      }

      const freq = term > 1 ? 'M' : 'I';
      const newCiLine = `CI|CO018670|22038|30092026|${memberId}|B|${acctNo}|21|AC||PHP|PHP|01012025||01012026|||||${amount}|${term}|NA||${freq}||3000||0|||1|${amount}|1|${amount}|6||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||`;
      
      db.ciLines.push(newCiLine);
      renderLoans();
      renderDashboard();
      previewReport();
      alert('Na-add na ang bag-ong Loan Contract (CI)!');
    }

    function editLoan(index) {
      if (!verifyPassword()) return;
      const currentLine = db.ciLines[index];
      const parts = currentLine.split('|');
      const newAmount = prompt("Usba ang Loan Amount (PHP):", parts[18]);
      if (newAmount === null) return;
      const newTerm = prompt("Usba ang Term (Months):", parts[19]);
      if (newTerm === null) return;

      parts[18] = newAmount;
      parts[19] = newTerm;
      parts[23] = parseInt(newTerm) > 1 ? 'M' : 'I';
      db.ciLines[index] = parts.join('|');

      renderLoans();
      renderDashboard();
      previewReport();
      alert("Na-update na ang Credit Contract record!");
    }

    function deleteLoan(index) {
      if (!verifyPassword()) return;
      if (confirm("Sigurado ka ba nga i-delete kining Credit Record (CI)?")) {
        db.ciLines.splice(index, 1);
        renderLoans();
        renderDashboard();
        previewReport();
        alert("Na-delete na ang Loan Contract.");
      }
    }

    function renderProducts() {
      const tbody = document.getElementById('product-table-body');
      tbody.innerHTML = '';
      db.products.forEach((p, index) => {
        tbody.innerHTML += `<tr>
          <td class="py-3 px-3 font-semibold">${p.name}</td>
          <td class="py-3 px-3">${p.interest}%</td>
          <td class="py-3 px-3">${p.penalty}%</td>
          <td class="py-3 px-3">${p.term} Months</td>
          <td class="py-3 px-3 space-x-2">
            <button onclick="editProduct(${index})" class="bg-amber-500 hover:bg-amber-600 text-white px-2.5 py-1 rounded text-xs"><i class="fa-solid fa-pen"></i> Edit</button>
            <button onclick="deleteProduct(${index})" class="bg-red-500 hover:bg-red-600 text-white px-2.5 py-1 rounded text-xs"><i class="fa-solid fa-trash"></i> Delete</button>
          </td>
        </tr>`;
      });
    }

    function renderMembers() {
      const tbody = document.getElementById('member-table-body');
      tbody.innerHTML = '';
      document.getElementById('member-count-badge').innerText = db.idLines.length;
      db.idLines.forEach((line, index) => {
        const parts = line.split('|');
        const memberId = parts[4] || 'N/A';
        const fname = parts[6] || '';
        const lname = parts[8] || '';
        tbody.innerHTML += `<tr>
          <td class="py-3 px-3 font-semibold text-blue-600">${memberId}</td>
          <td class="py-3 px-3 font-sans font-medium text-slate-700">${fname} ${lname}</td>
          <td class="py-3 px-3 text-slate-500 truncate max-w-xs" title="${line}">${line}</td>
          <td class="py-3 px-3 space-x-2 whitespace-nowrap">
            <button onclick="editMember(${index})" class="bg-amber-500 hover:bg-amber-600 text-white px-2.5 py-1 rounded text-xs"><i class="fa-solid fa-pen"></i> Edit</button>
            <button onclick="deleteMember(${index})" class="bg-red-500 hover:bg-red-600 text-white px-2.5 py-1 rounded text-xs"><i class="fa-solid fa-trash"></i> Delete</button>
          </td>
        </tr>`;
      });
    }

    function renderLoans() {
      const tbody = document.getElementById('loan-table-body');
      tbody.innerHTML = '';
      document.getElementById('loan-count-badge').innerText = db.ciLines.length;
      db.ciLines.forEach((line, index) => {
        const parts = line.split('|');
        const memberId = parts[4] || 'N/A';
        const loanId = parts[6] || 'N/A';
        const term = parseInt(parts[19]) || 1;
        const contractType = (term > 1 || parts[23] !== 'I') ? '<span class="text-blue-600 font-semibold">Installment</span>' : '<span class="text-amber-600 font-semibold">Non-Installment</span>';
        
        tbody.innerHTML += `<tr>
          <td class="py-3 px-3 font-semibold text-emerald-600">${loanId}</td>
          <td class="py-3 px-3 font-semibold">${memberId}</td>
          <td class="py-3 px-3">${contractType}</td>
          <td class="py-3 px-3 text-slate-500 truncate max-w-xs" title="${line}">${line}</td>
          <td class="py-3 px-3 space-x-2 whitespace-nowrap">
            <button onclick="editLoan(${index})" class="bg-amber-500 hover:bg-amber-600 text-white px-2.5 py-1 rounded text-xs"><i class="fa-solid fa-pen"></i> Edit</button>
            <button onclick="deleteLoan(${index})" class="bg-red-500 hover:bg-red-600 text-white px-2.5 py-1 rounded text-xs"><i class="fa-solid fa-trash"></i> Delete</button>
          </td>
        </tr>`;
      });
    }

    function buildPipeReport() {
      const provider = document.getElementById('r-provider').value;
      const branch = document.getElementById('r-branch').value;
      const asOfDate = document.getElementById('r-asofdate').value;
      const totalRecs = db.idLines.length + db.ciLines.length;

      let lines = [];
      lines.push(`HD|${provider}|${asOfDate}|1.0|0|`);
      
      db.idLines.forEach(line => {
        lines.push(line);
      });

      db.ciLines.forEach(line => {
        lines.push(line);
      });

      lines.push(`FT|${provider}|${asOfDate}|${totalRecs}`);
      return lines.join("\n");
    }

    function previewReport() {
      document.getElementById('report-preview-box').innerText = buildPipeReport();
    }

    function downloadReportFile() {
      const content = buildPipeReport();
      const filename = `${document.getElementById('r-provider').value}_CSDF_${document.getElementById('r-asofdate').value}.txt`;
      const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    }

    init();
  </script>
</body>
</html>
